{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.appsea.local/opportunity.schema.json",
  "title": "AppSea Opportunity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "opportunity_id",
    "tenant_id",
    "title",
    "slug",
    "state",
    "category",
    "target_segments",
    "problem_statement",
    "proposed_wedge",
    "excluded_scope",
    "supporting_cluster_ids",
    "competitor_relation_ids",
    "contrary_evidence_ids",
    "assumptions",
    "dependencies",
    "risks",
    "confidence",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "opportunity_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 180
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "state": {
      "enum": ["signal", "candidate", "researched", "planned", "approved", "monitoring", "archived"]
    },
    "category": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "target_segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 160
      }
    },
    "problem_statement": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2000
    },
    "proposed_wedge": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2000
    },
    "excluded_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 500
      }
    },
    "supporting_cluster_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
      }
    },
    "app_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
      }
    },
    "competitor_relation_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
      }
    },
    "contrary_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "status", "validation_method"],
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 3,
            "maxLength": 800
          },
          "status": {
            "enum": ["untested", "supported", "weakened", "rejected"]
          },
          "validation_method": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 500
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["risk", "severity", "mitigation"],
        "properties": {
          "risk": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          },
          "severity": {
            "enum": ["low", "medium", "high", "critical"]
          },
          "mitigation": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          }
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
