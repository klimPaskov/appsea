{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.appsea.local/complaint_cluster.schema.json",
  "title": "AppSea Complaint Cluster",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cluster_id",
    "tenant_id",
    "working_label",
    "problem_statement",
    "complaint_ids",
    "app_ids",
    "metrics",
    "stability",
    "review_state",
    "cluster_version",
    "updated_at"
  ],
  "properties": {
    "cluster_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
    },
    "working_label": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "problem_statement": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1500
    },
    "complaint_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
      }
    },
    "app_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complaint_count",
        "unique_author_count",
        "source_count",
        "median_severity",
        "recent_30d_count"
      ],
      "properties": {
        "complaint_count": {
          "type": "integer",
          "minimum": 1
        },
        "unique_author_count": {
          "type": "integer",
          "minimum": 0
        },
        "source_count": {
          "type": "integer",
          "minimum": 1
        },
        "median_severity": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "recent_30d_count": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "stability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "review_state": {
      "enum": ["provisional", "reviewed", "confirmed", "split", "merged", "rejected"]
    },
    "cluster_version": {
      "type": "string",
      "minLength": 1
    },
    "representative_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
      }
    },
    "contrary_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
