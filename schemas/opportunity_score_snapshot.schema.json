{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.appsea.local/opportunity_score_snapshot.schema.json",
  "title": "AppSea Opportunity Score Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "score_snapshot_id",
    "opportunity_id",
    "profile",
    "weight_version",
    "scorer_version",
    "factor_breakdown",
    "raw_score",
    "risk_penalty",
    "risk_adjusted_score",
    "confidence",
    "uncertainty_margin",
    "ranking_score",
    "warnings",
    "computed_at"
  ],
  "properties": {
    "score_snapshot_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
    },
    "opportunity_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
    },
    "profile": {
      "enum": ["balanced", "founder", "enterprise", "indie", "data_confidence"]
    },
    "weight_version": {
      "type": "string",
      "minLength": 1
    },
    "scorer_version": {
      "type": "string",
      "minLength": 1
    },
    "factor_breakdown": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "direction",
          "normalized_value",
          "weight",
          "contribution",
          "evidence_refs"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,63}$"
          },
          "direction": {
            "enum": ["positive", "risk"]
          },
          "normalized_value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "contribution": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
            }
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "raw_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "risk_penalty": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "risk_adjusted_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "uncertainty_margin": {
      "type": "number",
      "minimum": 0,
      "maximum": 20
    },
    "ranking_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "computed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
