{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.appsea.local/research_report.schema.json",
  "title": "AppSea Research Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "opportunity_id",
    "version",
    "generated_at",
    "method",
    "coverage",
    "executive_summary",
    "findings",
    "cluster_ids",
    "competitor_relation_ids",
    "contrary_evidence",
    "score_snapshot_id",
    "uncertainties",
    "recommendations",
    "provenance"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
    },
    "opportunity_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign_ids", "skills", "models", "time_window"],
      "properties": {
        "campaign_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "time_window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {
              "type": "string",
              "format": "date-time"
            },
            "end": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ids", "missing_sources", "languages", "item_count", "complaint_count"],
      "properties": {
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
          }
        },
        "missing_sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 16
          }
        },
        "item_count": {
          "type": "integer",
          "minimum": 0
        },
        "complaint_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "executive_summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 5000
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "claim", "claim_type", "confidence", "evidence_ids"],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
          },
          "claim": {
            "type": "string",
            "minLength": 10,
            "maxLength": 2000
          },
          "claim_type": {
            "enum": ["observed", "derived", "inference", "recommendation"]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
            }
          }
        }
      }
    },
    "cluster_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
      }
    },
    "competitor_relation_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
      }
    },
    "contrary_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "evidence_ids", "impact"],
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 5,
            "maxLength": 1000
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
            }
          },
          "impact": {
            "enum": ["minor", "material", "blocking"]
          }
        }
      }
    },
    "score_snapshot_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 1000
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 1000
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_snapshot_id", "generator_version"],
      "properties": {
        "evidence_snapshot_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
        },
        "generator_version": {
          "type": "string",
          "minLength": 1
        },
        "source_ledger_path": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
