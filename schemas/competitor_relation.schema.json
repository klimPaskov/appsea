{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.appsea.local/competitor_relation.schema.json",
  "title": "AppSea Competitor Relation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "relation_id",
    "tenant_id",
    "subject_id",
    "object_id",
    "relation_type",
    "problem_cluster_ids",
    "evidence_ids",
    "confidence",
    "observed_at",
    "review_state"
  ],
  "properties": {
    "relation_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
    },
    "subject_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
    },
    "object_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
    },
    "relation_type": {
      "enum": [
        "direct_competitor",
        "adjacent_product",
        "substitute",
        "platform_feature",
        "manual_workflow",
        "do_nothing",
        "complement"
      ]
    },
    "problem_cluster_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
      }
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
      }
    },
    "shared_jobs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 300
      }
    },
    "differentiation_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 500
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_state": {
      "enum": ["unreviewed", "confirmed", "corrected", "rejected"]
    }
  }
}
