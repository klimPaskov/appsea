{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.appsea.local/research_campaign.schema.json",
  "title": "AppSea Research Campaign",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "campaign_id",
    "tenant_id",
    "name",
    "purpose",
    "status",
    "queries",
    "source_ids",
    "time_window",
    "budget",
    "languages",
    "retention_profile",
    "created_at"
  ],
  "properties": {
    "campaign_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160
    },
    "purpose": {
      "enum": ["product_research", "customer_authorized_analysis", "internal_quality"]
    },
    "status": {
      "enum": [
        "draft",
        "validated",
        "queued",
        "running",
        "paused",
        "completed",
        "partial",
        "failed",
        "canceled",
        "expired"
      ]
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query", "intent"],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 500
          },
          "intent": {
            "enum": [
              "complaint",
              "workaround",
              "competitor",
              "contrary_evidence",
              "category_discovery"
            ]
          },
          "app_hint": {
            "type": ["string", "null"],
            "maxLength": 160
          }
        }
      }
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
      }
    },
    "time_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "hard_limit", "model_token_limit", "max_items"],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "hard_limit": {
          "type": "number",
          "minimum": 0
        },
        "model_token_limit": {
          "type": "integer",
          "minimum": 0
        },
        "max_items": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 16
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "retention_profile": {
      "enum": ["minimal", "standard", "extended", "customer_defined"]
    },
    "coverage_requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum_sources": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_unique_authors": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_complaints": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "created_by": {
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9_:-]{2,127}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
