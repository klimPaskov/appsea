# syntax=docker/dockerfile:1.7

FROM node:22.14.0-bookworm-slim AS build

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH

RUN npm install --global pnpm@11.11.0
WORKDIR /app

COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @appsea/worker build

FROM node:22.14.0-bookworm-slim AS runtime

ENV NODE_ENV=production \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH

RUN npm install --global pnpm@11.11.0
WORKDIR /app

RUN groupadd --system --gid 10001 appsea \
  && useradd --system --uid 10001 --gid appsea --create-home appsea

COPY --from=build --chown=appsea:appsea /app/package.json ./package.json
COPY --from=build --chown=appsea:appsea /app/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=build --chown=appsea:appsea /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=build --chown=appsea:appsea /app/.npmrc ./.npmrc
COPY --from=build --chown=appsea:appsea /app/node_modules ./node_modules
COPY --from=build --chown=appsea:appsea /app/apps ./apps
COPY --from=build --chown=appsea:appsea /app/packages ./packages

USER appsea

ENTRYPOINT ["pnpm", "--filter", "@appsea/worker"]
CMD ["workflow:worker"]
