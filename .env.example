# Local development only. Use a secrets manager and verified TLS in production.
NODE_ENV=development
DATABASE_URL=postgres://appsea_service:appsea-service-local-only@localhost:5433/appsea
APPSEA_MAINTENANCE_DATABASE_URL=postgres://appsea_maintenance:appsea-maintenance-local-only@localhost:5433/appsea
APPSEA_MIGRATION_DATABASE_URL=postgres://appsea_migrator:appsea-migrator-local-only@localhost:5433/appsea
APPSEA_DATABASE_MIGRATION_ROLE=appsea_owner
APPSEA_DATABASE_SSL_MODE=disable
APPSEA_DATABASE_APPLICATION_NAME=appsea-local
APPSEA_DATABASE_POOL_MAX=10
APPSEA_DATABASE_CONNECTION_TIMEOUT_MS=5000
APPSEA_DATABASE_IDLE_TIMEOUT_MS=30000
APPSEA_DATABASE_STATEMENT_TIMEOUT_MS=30000
APPSEA_TEMPORAL_ADDRESS=127.0.0.1:7233
# Production workers and web clients require a non-loopback endpoint, an
# explicit namespace, a Temporal API key, and a PEM/base64 pinned CA.
# APPSEA_TEMPORAL_NAMESPACE=appsea
# APPSEA_TEMPORAL_API_KEY=
# APPSEA_TEMPORAL_TLS_CA=
# Scheduled maintenance runs through the least-privilege appsea_maintenance
# connection above. It requires a unique stable owner ID in production;
# development and test commands generate an ephemeral owner when this is omitted.
# APPSEA_SCHEDULER_OWNER_ID=worker:prod-1
# APPSEA_MAINTENANCE_LEASE_SECONDS=900
# The deployment-owned loop starts one bounded source-maintenance pass at a
# time. The database lease still prevents duplicate work across instances.
# APPSEA_MAINTENANCE_INTERVAL_SECONDS=60
# APPSEA_MAINTENANCE_FAILURE_BACKOFF_SECONDS=30
# Durable scheduler metrics are retained through this bounded maintenance-role
# purge after each run.
# APPSEA_MAINTENANCE_METRICS_RETENTION_DAYS=30
# APPSEA_MAINTENANCE_METRICS_PURGE_BATCH_SIZE=1000
# Deployment-owned cost inspection thresholds. Values are exact micro-units in
# the configured currency; this command reports pressure but never blocks work.
# APPSEA_COST_ALERT_MAX_WORKSPACES=1000
# APPSEA_COST_ALERT_MAX_CURRENCIES_PER_WORKSPACE=16
# APPSEA_COST_ALERT_PERIOD_SECONDS=2592000
# APPSEA_COST_ALERT_CURRENCY=USD
# APPSEA_COST_ALERT_ACTUAL_THRESHOLD_MICROS=0
# APPSEA_COST_ALERT_ESTIMATED_THRESHOLD_MICROS=0
# Deployment-owned operational alert routing. Production preflight requires an
# HTTPS endpoint and a separate 32-byte base64url secret; local runs keep this
# switch disabled unless a loopback test sink is explicitly configured.
APPSEA_ALERT_ROUTING_ENABLED=false
APPSEA_ALERT_ROUTING_URL=
APPSEA_ALERT_ROUTING_SECRET=
# Local development fallback for the durable worker and source-maintenance
# command. Production must use the complete S3-compatible settings below.
# APPSEA_OBJECT_STORE_ROOT=
# APPSEA_OBJECT_STORE_ENDPOINT=https://objects.example.test
# APPSEA_OBJECT_STORE_BUCKET=
# APPSEA_OBJECT_STORE_REGION=us-east-1
# APPSEA_OBJECT_STORE_ACCESS_KEY_ID=
# APPSEA_OBJECT_STORE_SECRET_ACCESS_KEY=
# APPSEA_OBJECT_STORE_SESSION_TOKEN=
# APPSEA_OBJECT_STORE_FORCE_PATH_STYLE=false
# APPSEA_OBJECT_STORE_ALLOW_INSECURE_LOCALHOST=false

# Password recovery uses a separately operated, HMAC-authenticated delivery
# gateway. Leave unset in local fixture mode; production must configure both.
APPSEA_PUBLIC_ORIGIN=http://localhost:3000
APPSEA_AUTH_RECOVERY_ENABLED=false
# Existing-account workspace invitation delivery is separately kill-switched.
APPSEA_AUTH_INVITATIONS_ENABLED=false
APPSEA_AUTH_RECOVERY_ENCRYPTION_KEY=
APPSEA_AUTH_RECOVERY_DELIVERY_URL=
APPSEA_AUTH_RECOVERY_DELIVERY_SECRET=
# Optional OIDC is disabled by default. Linkage is always explicit to an
# existing password account; never enable this switch without independent
# identity, privacy, delivery, and security review.
APPSEA_AUTH_OIDC_ENABLED=false
APPSEA_AUTH_OIDC_ISSUER=
APPSEA_AUTH_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
# Optional comma-separated HTTPS origins for provider discovery endpoints;
# the configured issuer origin is always allowed.
APPSEA_AUTH_OIDC_ENDPOINT_ORIGINS=
APPSEA_AUTH_OIDC_CLIENT_ID=
APPSEA_AUTH_OIDC_CLIENT_SECRET=
APPSEA_AUTH_OIDC_REVIEWED=false
APPSEA_AUTH_OIDC_ACCOUNT_LINKING=explicit
# Separate 32-byte base64url key for encrypted TOTP enrollment secrets.
APPSEA_AUTH_MFA_ENCRYPTION_KEY=
# Monotonic ciphertext key version. Existing rows default to version 1.
APPSEA_AUTH_MFA_ENCRYPTION_KEY_VERSION=1
# During reviewed rotation, keep the prior key/version until the status command
# reports zero previous/unknown rows. Never print these values to logs.
APPSEA_AUTH_MFA_ENCRYPTION_KEY_PREVIOUS=
APPSEA_AUTH_MFA_ENCRYPTION_KEY_PREVIOUS_VERSION=
# One bounded, lease-owned dormant-account rewrap batch per invocation.
# Repeat `pnpm worker:auth:mfa:rotation:rewrap` until the status command reports
# zero previous-key accounts; the command fails closed on unknown versions.
# APPSEA_AUTH_MFA_ROTATION_BATCH_SIZE=100
# Optional: 32-byte base64url secret used by trusted ingress to sign the
# client marker. Production ignores arbitrary X-Forwarded-For headers.
APPSEA_TRUSTED_PROXY_SECRET=

# Integration tests deliberately require a local database with "test" in its name.
APPSEA_TEST_DATABASE_URL=postgres://appsea_service:appsea-service-local-only@localhost:5433/appsea_test
APPSEA_TEST_MAINTENANCE_DATABASE_URL=postgres://appsea_maintenance:appsea-maintenance-local-only@localhost:5433/appsea_test
APPSEA_TEST_MIGRATION_DATABASE_URL=postgres://appsea_migrator:appsea-migrator-local-only@localhost:5433/appsea_test
APPSEA_ALLOW_DESTRUCTIVE_DB_TESTS=no
