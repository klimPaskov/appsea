# Local development only. Use a secrets manager and verified TLS in production.
DATABASE_URL=postgres://appsea_service:appsea-service-local-only@localhost:5433/appsea
APPSEA_MIGRATION_DATABASE_URL=postgres://appsea_migrator:appsea-migrator-local-only@localhost:5433/appsea
APPSEA_DATABASE_MIGRATION_ROLE=appsea_owner
APPSEA_DATABASE_SSL_MODE=disable
APPSEA_DATABASE_APPLICATION_NAME=appsea-local
APPSEA_DATABASE_POOL_MAX=10
APPSEA_DATABASE_CONNECTION_TIMEOUT_MS=5000
APPSEA_DATABASE_IDLE_TIMEOUT_MS=30000
APPSEA_DATABASE_STATEMENT_TIMEOUT_MS=30000
APPSEA_TEMPORAL_ADDRESS=127.0.0.1:7233

# Password recovery uses a separately operated, HMAC-authenticated delivery
# gateway. Leave unset in local fixture mode; production must configure both.
APPSEA_PUBLIC_ORIGIN=http://localhost:3000
APPSEA_AUTH_RECOVERY_ENABLED=false
# Existing-account workspace invitation delivery is separately kill-switched.
APPSEA_AUTH_INVITATIONS_ENABLED=false
APPSEA_AUTH_RECOVERY_ENCRYPTION_KEY=
APPSEA_AUTH_RECOVERY_DELIVERY_URL=
APPSEA_AUTH_RECOVERY_DELIVERY_SECRET=
# Optional: 32-byte base64url secret used by trusted ingress to sign the
# client marker. Production ignores arbitrary X-Forwarded-For headers.
APPSEA_TRUSTED_PROXY_SECRET=

# Integration tests deliberately require a local database with "test" in its name.
APPSEA_TEST_DATABASE_URL=postgres://appsea_service:appsea-service-local-only@localhost:5433/appsea_test
APPSEA_TEST_MIGRATION_DATABASE_URL=postgres://appsea_migrator:appsea-migrator-local-only@localhost:5433/appsea_test
APPSEA_ALLOW_DESTRUCTIVE_DB_TESTS=no
