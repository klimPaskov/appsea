{
  "name": "appsea",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @appsea/web dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && node scripts/run_python.mjs scripts/check_repo.py",
    "verify": "pnpm agents:sync && pnpm format:check && turbo run lint typecheck test build --output-logs=errors-only && pnpm worker:fixture && pnpm plan:sample && pnpm analysis:sample && pnpm smoke:web && pnpm repo:check",
    "agents:sync": "node scripts/run_python.mjs scripts/sync_agents.py && prettier --write AGENTS.md docs/generated/skill-catalog.md docs/generated/subagent-catalog.md docs/generated/repository-map.md",
    "memory": "node scripts/run_python.mjs scripts/memory.py",
    "memory:status": "node scripts/run_python.mjs scripts/memory.py status",
    "memory:check": "node scripts/run_python.mjs scripts/memory.py validate",
    "memory:search": "node scripts/run_python.mjs scripts/memory.py search",
    "memory:add": "node scripts/run_python.mjs scripts/memory.py add",
    "memory:session": "node scripts/run_python.mjs scripts/memory.py session",
    "docs:check": "node scripts/run_python.mjs scripts/check_repo.py --docs-only",
    "repo:check": "node scripts/run_python.mjs scripts/check_repo.py",
    "db:migrate": "pnpm --filter @appsea/db migrate",
    "db:test:integration": "pnpm --filter @appsea/db test:integration",
    "verify:persistence": "node scripts/run_db_integration.mjs",
    "verify:persistence:fresh": "node scripts/run_db_integration.mjs --fresh",
    "verify:workflows": "node scripts/run_workflow_integration.mjs",
    "verify:workflows:fresh": "node scripts/run_workflow_integration.mjs --fresh",
    "worker:fixture": "pnpm --filter @appsea/worker fixture",
    "worker:fixture:persist": "pnpm --filter @appsea/worker fixture:persist",
    "worker:source:cfpb": "pnpm --filter @appsea/worker source:cfpb",
    "worker:source:policy:cfpb": "pnpm --filter @appsea/worker source:policy:cfpb",
    "worker:workflow:fixture": "pnpm --filter @appsea/worker workflow:fixture",
    "plan:sample": "pnpm --filter @appsea/worker plan:sample",
    "analysis:sample": "pnpm --filter @appsea/worker analysis:sample",
    "ui:references": "node scripts/run_python.mjs scripts/render_references.py",
    "manifest": "node scripts/run_python.mjs scripts/generate_manifest.py",
    "setup": "pnpm agents:sync && pnpm memory:check && pnpm docs:check",
    "clean": "node scripts/clean.mjs",
    "smoke:web": "node scripts/run_python.mjs scripts/smoke_web.py"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "eslint": "10.6.0",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "tsx": "4.23.0",
    "turbo": "2.10.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10"
  },
  "type": "module"
}
